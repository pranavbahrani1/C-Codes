#include <stdio.h>
int main()
{
    int num=0,bit=0;
    printf("Enter a decimal number :- ");
    scanf("%d",&num);

    if (num==0)
    printf("\n 0");
    while(num!=0)
    {
        bit=num%2;
        printf("\n %d",bit);
        num=num/2;
    }  

    printf("\n\n");

    return 0;
}